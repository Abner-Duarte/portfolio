---
import { t, type Lang } from '../i18n';
import { profile } from '../data/profile';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const c = profile.contact;
const links = [
  { label: 'E-mail', value: c.email, href: `mailto:${c.email}`, ext: false },
  { label: 'LinkedIn', value: 'abner-evandro-duarte', href: c.linkedin, ext: true },
  { label: 'GitHub', value: 'Abner-Duarte', href: c.github, ext: true },
];
---

<Section id="contato" title={dict.sections.contact} intro={dict.sections.contactIntro}>
  <div class="box">
    <div class="main">
      <a class="btn primary big" href={c.whatsapp} target="_blank" rel="noopener">
        {dict.labels.whatsapp} · {c.phone}
      </a>
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <span class="label">{l.label}</span>
              <a href={l.href} {...(l.ext ? { target: '_blank', rel: 'noopener' } : {})}>
                {l.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="cv">
      <a class="btn ghost" href={profile.cv.pt} download>{dict.labels.cvPt}</a>
      <a class="btn ghost" href={profile.cv.en} download>{dict.labels.cvEn}</a>
      <p class="avail">{profile.location[lang]} · {profile.availability[lang]}</p>
    </div>
  </div>
</Section>

<style>
  .box {
    display: grid;
    gap: var(--space-6);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6) var(--space-5);
    box-shadow: var(--shadow);
  }
  @media (min-width: 860px) {
    .box {
      grid-template-columns: 1.3fr 1fr;
      padding: var(--space-7) var(--space-6);
    }
  }
  .big {
    font-size: var(--step-0);
    min-height: 52px;
    width: 100%;
    max-width: 26rem;
  }
  .links {
    list-style: none;
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-3);
  }
  .links li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }
  .label {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 600;
    padding-top: 2px;
  }
  .links a {
    overflow-wrap: anywhere;
    font-weight: 600;
  }
  .cv {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: stretch;
  }
  .avail {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: var(--space-2);
  }
</style>
