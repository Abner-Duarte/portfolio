---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { t, base, type Lang } from '../i18n';
import type { CaseStudy } from '../data/caseStudies';

interface Props {
  study: CaseStudy;
  lang: Lang;
}
const { study: s, lang } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const path = `${base(lang)}/${lang === 'pt' ? 'projetos' : 'projects'}/${s.slug}/`;
const altPath = `${base(other)}/${other === 'pt' ? 'projetos' : 'projects'}/${s.slug}/`;
const homeProjects = `${base(lang)}/#projetos`;
const sections = [
  { title: dict.caseStudy.built, items: s.built },
  { title: dict.caseStudy.decisions, items: s.decisions },
  { title: dict.caseStudy.results, items: s.results },
];
---

<Base lang={lang} title={`${s.title[lang]} · ${dict.caseStudy.label} · Abner Duarte`} description={s.lead[lang]} path={path} altPath={altPath}>
  <article class="case">
    <header class="hero">
      <div class="container narrow">
        <a class="back" href={homeProjects}>{dict.caseStudy.back}</a>
        <h1>{s.title[lang]}</h1>
        <p class="lead">{s.lead[lang]}</p>
        <ul class="tags">
          {s.stack.map((x) => <li>{x}</li>)}
        </ul>
        {
          s.links.length > 0 && (
            <div class="actions">
              {s.links.map((l, i) => (
                <a class:list={['btn', i === 0 ? 'primary' : 'ghost']} href={l.href} target="_blank" rel="noopener">
                  {l.label[lang]}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="container narrow body">
      <section>
        <h2>{dict.caseStudy.problem}</h2>
        <p class="problem">{s.problem[lang]}</p>
      </section>

      {
        sections.map((sec) => (
          <section>
            <h2>{sec.title}</h2>
            <ul class="points">
              {sec.items.map((i) => (
                <li>{i[lang]}</li>
              ))}
            </ul>
          </section>
        ))
      }

      {
        s.images.length > 0 && (
          <section>
            <h2>{dict.caseStudy.gallery}</h2>
            <div class="gallery">
              {s.images.map((img) => (
                <figure>
                  <Image src={img.src} alt={img.alt[lang]} widths={[480, 900, 1400]} sizes="(min-width: 900px) 820px, 100vw" />
                  <figcaption>{img.alt[lang]}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      <p class="foot"><a href={homeProjects}>{dict.caseStudy.back}</a></p>
    </div>
  </article>
</Base>

<style>
  .narrow {
    max-width: 880px;
  }
  .hero {
    padding-block: var(--space-7);
    background:
      radial-gradient(50rem 24rem at 90% -20%, var(--accent-soft), transparent 70%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .back {
    font-weight: 600;
    font-size: var(--step--1);
    text-decoration: none;
  }
  h1 {
    font-size: var(--step-3);
    margin-top: var(--space-4);
    overflow-wrap: anywhere;
  }
  .lead {
    margin-top: var(--space-4);
    font-size: var(--step-1);
    color: var(--muted);
    line-height: 1.5;
  }
  .tags {
    margin-top: var(--space-5);
  }
  .actions {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .body {
    padding-block: var(--space-7) var(--space-8);
    display: grid;
    gap: var(--space-7);
  }
  h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-4);
  }
  .problem {
    font-size: var(--step-0);
    border-left: 3px solid var(--accent);
    padding-left: var(--space-4);
  }
  .points {
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-3);
  }
  .points li::marker {
    color: var(--accent);
  }
  .gallery {
    display: grid;
    gap: var(--space-6);
  }
  figure {
    margin: 0;
  }
  figure :global(img) {
    width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: #fff;
  }
  figcaption {
    margin-top: var(--space-2);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .foot {
    font-weight: 600;
  }
</style>
