---
import { t, type Lang } from '../i18n';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
---

<section id="provas" class="proofs" aria-label={dict.sections.proofs}>
  <div class="container">
    <ul class="grid">
      {
        profile.proofs.map((p) => (
          <li class="item">
            {p.href ? (
              <a class="value" href={p.href} target="_blank" rel="noopener">
                {p.value[lang]}
              </a>
            ) : (
              <span class="value">{p.value[lang]}</span>
            )}
            <span class="label">{p.label[lang]}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proofs {
    border-block: 1px solid var(--border);
    background: var(--card);
  }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-3);
  }
  .item + .item {
    border-left: 1px solid var(--border);
    padding-left: var(--space-5);
  }
  @media (max-width: 859px) {
    .item:nth-child(3) {
      border-left: 0;
      padding-left: var(--space-3);
    }
    .item:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  .value {
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
    text-decoration: none;
  }
  a.value {
    color: var(--accent);
  }
  a.value::after {
    content: ' ↗';
    font-size: 0.6em;
    vertical-align: super;
  }
  .label {
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
