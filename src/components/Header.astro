---
import { t, base, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  altPath: string;
}
const { lang, altPath } = Astro.props;
const dict = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const home = `${base(lang)}/`;
const links = [
  { href: `${home}#projetos`, label: dict.nav.projects },
  { href: `${home}#servicos`, label: dict.nav.services },
  { href: `${home}#trajetoria`, label: dict.nav.journey },
  { href: `${home}#experiencia`, label: dict.nav.experience },
  { href: `${home}#contato`, label: dict.nav.contact },
];
---

<header class="site-header" data-header>
  <div class="container bar">
    <a class="brand" href={home}>
      <span class="mark" aria-hidden="true">AD</span>
      <span>Abner Duarte</span>
    </a>

    <nav id="menu-principal" class="nav" aria-label={dict.menu}>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <a class="lang" href={altPath} hreflang={t(other).htmlLang} title={dict.langSwitchLabel}>
        {other.toUpperCase()}<span class="visually-hidden"> · {dict.langSwitchLabel}</span>
      </a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label={dict.themeToggle} title={dict.themeToggle}>
        <svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path
            d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-controls="menu-principal" aria-expanded="false" aria-label={dict.menu}>
        <span class="burger" aria-hidden="true"></span>
        <span class="menu-label">{dict.menu}</span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('menu-principal');

  function setOpen(open: boolean) {
    header?.toggleAttribute('data-open', open);
    menuBtn?.setAttribute('aria-expanded', String(open));
  }
  menuBtn?.addEventListener('click', () => setOpen(!header?.hasAttribute('data-open')));
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* sem armazenamento: o tema vale só para esta visita */
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 64px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 0.8rem;
    font-weight: 800;
  }
  .nav {
    order: 3;
    flex-basis: 100%;
  }
  .nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding-bottom: var(--space-3);
  }
  .nav a {
    color: var(--muted);
    font-weight: 500;
    font-size: var(--step--1);
    text-decoration: none;
    display: inline-block;
    padding-block: var(--space-2);
  }
  .nav a:hover {
    color: var(--accent);
  }
  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .lang {
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--fg);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 12px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
  }
  .lang:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    min-width: 40px;
    justify-content: center;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg);
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    padding: 0 10px;
  }
  .icon-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .moon {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: none;
  }
  :global([data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  .menu-btn {
    display: none;
  }
  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 16px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s ease;
  }
  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .burger::before {
    top: -5px;
  }
  .burger::after {
    top: 5px;
  }

  /* Com JavaScript, no celular o menu fica recolhido atrás do botão. */
  @media (max-width: 859px) {
    :global(.js) .menu-btn {
      display: inline-flex;
    }
    :global(.js) .nav {
      display: none;
    }
    :global(.js) [data-open] .nav {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav li + li {
      border-top: 1px solid var(--border);
    }
    .nav a {
      display: block;
      padding-block: var(--space-3);
      font-size: var(--step-0);
    }
    [data-open] .burger {
      background: transparent;
    }
    [data-open] .burger::before {
      transform: translateY(5px) rotate(45deg);
    }
    [data-open] .burger::after {
      transform: translateY(-5px) rotate(-45deg);
    }
  }
  @media (max-width: 420px) {
    .menu-label {
      display: none;
    }
  }
  @media (min-width: 860px) {
    .bar {
      flex-wrap: nowrap;
    }
    .nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
    }
    .nav ul {
      padding-bottom: 0;
      gap: var(--space-5);
    }
    .tools {
      margin-left: var(--space-4);
    }
  }
</style>
