---
import { t, type Lang } from '../i18n';
import { timeline } from '../data/timeline';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
---

<Section id="trajetoria" title={dict.sections.journey}>
  <ol class="line">
    {
      timeline.map((item) => (
        <li class="step">
          <span class="year">{item.year}</span>
          <div class="content">
            <h3>{item.href ? <a href={item.href} target="_blank" rel="noopener">{item.title}</a> : item.title}</h3>
            <p>{item.text[lang]}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .line {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
    display: grid;
    gap: var(--space-5);
  }
  .line::before {
    content: '';
    position: absolute;
    left: 2.1rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: linear-gradient(var(--border), var(--accent));
  }
  .step {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    position: relative;
  }
  .year {
    font-family: var(--mono);
    font-weight: 700;
    font-size: var(--step--1);
    background: var(--card);
    border: 1.5px solid var(--accent);
    color: var(--accent);
    border-radius: 999px;
    text-align: center;
    padding: 2px 0;
    position: relative;
    z-index: 1;
  }
  .step:last-child .year {
    background: var(--accent);
    color: var(--on-accent);
  }
  h3 {
    font-size: var(--step-1);
  }
  h3 a {
    color: inherit;
  }
  p {
    margin-top: var(--space-2);
    color: var(--muted);
    max-width: 70ch;
  }
</style>
