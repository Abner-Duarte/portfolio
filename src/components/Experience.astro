---
import { t, type Lang } from '../i18n';
import { experience } from '../data/experience';
import { profile } from '../data/profile';
import Section from './Section.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
---

<Section id="experiencia" title={dict.sections.experience} tone="soft">
  <p class="about">{profile.about[lang]}</p>
  <div class="list">
    {
      experience.map((e) => (
        <article class="job">
          <header>
            <h3>{e.role[lang]}</h3>
            <p class="org">
              {e.org} · <span>{e.period[lang]}</span>
            </p>
          </header>
          <ul>
            {e.bullets.map((b) => (
              <li>{b[lang]}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .about {
    max-width: 70ch;
    margin-bottom: var(--space-6);
    font-size: var(--step-0);
  }
  .list {
    display: grid;
    gap: var(--space-4);
  }
  .job {
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  h3 {
    font-size: var(--step-1);
  }
  .org {
    margin-top: var(--space-1);
    font-weight: 600;
  }
  .org span {
    color: var(--muted);
    font-weight: 400;
  }
  ul {
    margin-top: var(--space-3);
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-2);
    color: var(--muted);
  }
  li::marker {
    color: var(--accent);
  }
</style>
